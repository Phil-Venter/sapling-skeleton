{
    "name": "sapling/skeleton",
    "description": "A blank Sapling app.",
    "type": "project",
    "license": "0BSD",
    "require": {
        "php": ">=8.4",
        "sapling/core": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || file_put_contents('.env', 'APP_ENV=dev' . PHP_EOL . 'APP_KEY=' . base64_encode(random_bytes(32)) . PHP_EOL);\""
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public"
        ]
    }
}
